# Environment file for OpenPerouter Quadlet containers
# Copy this file to /etc/containers/systemd/router.env and customize as needed
#
# Usage:
#   sudo cp router.env.example /etc/containers/systemd/router.env
#   sudo vim /etc/containers/systemd/router.env
#   sudo systemctl daemon-reload
#   sudo systemctl restart routerpod.service controllerpod.service

# Router/Controller image (used by copier and controller containers)
ROUTER_IMAGE=quay.io/openperouter/router:main

# FRR routing daemon image (used by frr and reloader containers)
FRR_IMAGE=quay.io/frrouting/frr:10.2.1

# Examples:
# ROUTER_IMAGE=quay.io/openperouter/router:v1.0.0
# ROUTER_IMAGE=localhost/openperouter-router:dev
# FRR_IMAGE=quay.io/frrouting/frr:10.3.0
