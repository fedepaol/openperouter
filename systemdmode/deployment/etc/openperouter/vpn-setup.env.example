# OpenPERouter VPN Setup Environment Variables
# Copy this file to vpn-setup.env and customize for your environment
#
# Location: /etc/openperouter/vpn-setup.env

# ============================================================================
# Underlay Configuration (setup-underlay.service)
# ============================================================================

# Physical NIC to move into FRR namespace for underlay BGP connectivity
# This NIC will be used for VXLAN tunnel endpoints and BGP peering with TOR
UNDERLAY_NIC=eth1

# Timeout (in seconds) to wait for FRR container to become ready
# The setup will fail if FRR doesn't respond within this time
FRR_READY_TIMEOUT=60

# Node name used in FRR configuration (hostname)
# Leave commented to auto-detect from hostname
#NODE_NAME=$(hostname)

# ============================================================================
# BGP Configuration (generate-config.service)
# ============================================================================

# TOR (Top of Rack) switch IP address
# This is the BGP neighbor for underlay connectivity
TOR_IP=10.1.1.254

# TOR switch BGP AS number
TOR_AS=65000

# Local BGP AS number for this node
LOCAL_AS=64514

# ============================================================================
# VPN Configuration (generate-config.service)
# ============================================================================

# VRF (Virtual Routing and Forwarding) name
# Both L2 and L3 VPNs will use this VRF
VRF_NAME=red

# L3VPN VXLAN Network Identifier (VNI)
# Used for routed traffic (EVPN Type 5 routes)
L3_VNI=100

# L2VPN VXLAN Network Identifier (VNI)
# Used for bridged traffic (EVPN Type 2 routes)
L2_VNI=210

# VXLAN UDP destination port
# Standard IANA-assigned port is 4789
VXLAN_PORT=4789

# L2VPN gateway IP address (CIDR notation)
# This is the IP address assigned to the L2VPN bridge interface
L2_GATEWAY_IP=192.168.110.1/24

# ============================================================================
# File Paths (advanced - usually no need to change)
# ============================================================================

# File where setup-underlay.sh saves variables for generate-config.sh
#VARS_FILE=/var/lib/openperouter/vpn-setup.vars

# Path to YAML configuration template
#CONFIG_TEMPLATE=/etc/openperouter/templates/openpe_evpn.yaml.template

# Path where generated YAML configuration will be written
# Controller reads all openpe_*.yaml files from this directory
#CONFIG_OUTPUT=/var/lib/openperouter/configs/openpe_evpn.yaml
